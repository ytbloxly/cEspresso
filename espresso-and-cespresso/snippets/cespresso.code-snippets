{
  "Print statement": {
    "prefix": "print",
    "body": "print(${1:\"${2:text}\"})",
    "description": "Print a value"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:arguments}):",
      "\t$0"
    ],
    "description": "Declare a cEspresso function"
  },
  "If / elseif / else": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "\t${2:pass}",
      "elseif ${3:condition}:",
      "\t${4:pass}",
      "else:",
      "\t$0"
    ],
    "description": "Create a conditional"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = ${2:0}, $1 < ${3:10}, $1++):",
      "\t$0"
    ],
    "description": "Create a cEspresso-style counted loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "\t$0"
    ],
    "description": "Create a while loop"
  },
  "Typed variable": {
    "prefix": "typed",
    "body": "${1:int} ${2:name} = ${3:0}",
    "description": "Declare a statically typed variable"
  },
  "Optional variable": {
    "prefix": "optional",
    "body": "${1:int} ${2:name}? = ${3:nil}",
    "description": "Declare an optional typed variable"
  },
  "Interpolated string": {
    "prefix": "fstr",
    "body": "$\"${1:Text with {value}}\"",
    "description": "Create a string with interpolation"
  },
  "Prompt for input": {
    "prefix": "prompt",
    "body": "io.prompt(${1:\"${2:Prompt}\"})",
    "description": "Prompt for terminal input"
  }
}
